#!/bin/sh
# cberry config, run by `cberry start` (and again by `cberry reload`).
# Copy to ~/.config/cranberry/cberryrc. Every line is an ordinary cberry command,
# so you can also try them live in a terminal first.

# Space between windows, and around the edges (top right bottom left).
cberry config gap 8
cberry config padding 8 8 8 8

# How long a window takes to slide into place, in seconds (0 = off).
cberry config animation 0.25

# Share the old window keeps when a new one splits it.
cberry config split_ratio 0.5

# Step for `cberry resize <dir>`.
cberry config resize_step 0.05

# Drag a window by its title bar onto another to swap them. The target is
# highlighted with this colour: RRGGBB or RRGGBBAA (last two = opacity).
cberry config drag_swap on
cberry config drag_color 5e9eff40

# Hold this key and drag anywhere on a window: left button moves it
# (drop it on another window to swap), right button resizes it from the
# nearest corner. alt, cmd, ctrl, shift, fn, or off. While held, clicks do
# not reach the app, so pick a key your apps do not need for clicks.
cberry config mouse_modifier alt
cberry config mouse_action1 move
cberry config mouse_action2 resize

# Also hold this key while moving a tiled window: dropped near an edge of
# another window, it splits that window and takes the half on that side,
# rather than swapping with it. alt, cmd, ctrl, shift, fn, or off.
cberry config mouse_insert_modifier cmd

# Move the pointer to the window focused with `cberry focus` or `cberry swap`.
cberry config mouse_follows_focus off

# Focus (and raise) the window the pointer rests on.
cberry config focus_follows_mouse off

# Apps that are never tiled. Use the names `cberry query` shows; on a
# non-English Mac they are localized (e.g. "Sistem Ayarları").
cberry rule float "System Settings"
cberry rule float "Calculator"
cberry rule float "Archive Utility"

# Names for Spaces (numbered from 1, as in Mission Control), and apps whose
# new windows go to a Space, by number or name. `cberry label` lists them.
# cberry label 1 general
# cberry label 2 web
# cberry label 3 coding
# cberry rule space web "Safari"
# Apps whose new windows float at a place of their own: split the screen
# into rows:cols cells and take w x h of them from column x, row y
# (counted from 0).
# cberry rule grid 4:4:3:0:1:1 "Calculator"   # top right corner
# cberry rule grid 1:2:1:0:1:1 "Spotify"      # right half
# cberry rule grid 6:6:1:1:4:4 "Finder"       # centred, two thirds
# A Space whose windows are not tiled:
# cberry layout coding float

# A ring around the focused window. Set border_radius to your apps' corners.
# cberry config border on
# cberry config border_color 8aa9f8
# cberry config border_width 2
# cberry config border_radius 12
# cberry rule border_radius 0 "kitty"     # an app with square corners

# Keyboard shortcuts. `cberry ...` commands run inside
# cberry; anything else runs in your shell. `cberry bind` lists them.
cberry bind 'alt - h : cberry focus left'
cberry bind 'alt - j : cberry focus down'
cberry bind 'alt - k : cberry focus up'
cberry bind 'alt - l : cberry focus right'
cberry bind 'shift + alt - h : cberry swap left'
cberry bind 'shift + alt - j : cberry swap down'
cberry bind 'shift + alt - k : cberry swap up'
cberry bind 'shift + alt - l : cberry swap right'
cberry bind 'meh - h : cberry warp left'
cberry bind 'meh - j : cberry warp down'
cberry bind 'meh - k : cberry warp up'
cberry bind 'meh - l : cberry warp right'
cberry bind 'ctrl + alt - h : cberry resize left'
cberry bind 'ctrl + alt - j : cberry resize down'
cberry bind 'ctrl + alt - k : cberry resize up'
cberry bind 'ctrl + alt - l : cberry resize right'
cberry bind 'alt - r : cberry rotate'
cberry bind 'alt - e : cberry toggle-split'
cberry bind 'alt - 0 : cberry balance'
cberry bind 'alt - m : cberry zoom'
cberry bind 'alt - t : cberry float'
